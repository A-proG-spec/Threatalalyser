# ==========================================
# Node.js & Package Managers
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ==========================================
# Environment Variables (CRITICAL SECURITY)
# ==========================================
# Never commit API keys, database passwords, or JWTs!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env

# ==========================================
# Build Outputs
# ==========================================
# Frontend (Vite)
frontend/dist/
frontend/dist-ssr/
frontend/.vite/

# Backend (TypeScript)
backend/dist/
*.tsbuildinfo

# ==========================================
# Database & Prisma
# ==========================================
# Ignore local SQLite databases (if you ever switch from Postgres)
*.db
*.db-journal
# Prisma generated client (it's built from schema.prisma)
.prisma/
backend/prisma/*.db

# ==========================================
# Testing & Coverage
# ==========================================
coverage/
.nyc_output/
*.lcov

# ==========================================
# Logs & Debug
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ==========================================
# IDE & Editor Configs
# ==========================================
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-workspace

# ==========================================
# OS Generated Files
# ==========================================
.DS_Store
Thumbs.db